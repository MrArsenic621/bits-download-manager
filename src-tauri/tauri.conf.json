{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bits-download-manager",
  "version": "2.0.0",
  "identifier": "bits-download-manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bits Download Manager",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Bits Download Manager",
    "copyright": "Copyright © 2026 Bits Download Manager",
    "category": "Utility",
    "shortDescription": "Fast, modern download manager powered by aria2",
    "resources": ["bin/windows/aria2c.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
